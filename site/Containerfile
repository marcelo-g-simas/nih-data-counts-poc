# Multi-stage OCI build for the Data COUNTS leave-behind pipeline POC.
#
# Named Containerfile (podman/buildah's default) because podman is the
# reference engine for the leave-behind artifact -- daemonless and rootless,
# so operating it needs no root-owned socket. Nothing here is podman-specific:
# it is plain Dockerfile syntax with no BuildKit-only directives, so
# `make ENGINE=docker image-build` produces the same image. See site/Makefile.
#
# Stage "builder" runs `uv sync` and the online model-download/export step
# (the same thing `make setup` does on a bare host) once, at build time --
# so the final image is offline-ready from `podman run` onward with no
# separate setup step, which is a better fit for a "leave-behind" artifact
# than requiring a live run first. Pin FROM by digest before shipping this
# for real (see README's Packaging section) for byte-identical rebuilds.
FROM python:3.11-slim AS builder

# libgomp1: OpenMP runtime ONNX Runtime's CPU kernels (used by fast_gliner) link
# against; not always present on slim base images.
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Every `uv run`/`uv sync` step below imports Python modules (setup-models,
# nltk.download, the package's own build), and without this each import
# leaves a compiled .pyc behind under a __pycache__/ -- ~25MB of build-time
# litter that would otherwise ride into the final image (measured directly:
# `find /app/.venv -name __pycache__` before this fix). Sets it here, before
# any RUN that imports Python, so none of that ever gets written in the first
# place -- cheaper than compiling then deleting, and carries into the runtime
# stage's own ENV block below for the same reason at container start.
ENV PYTHONDONTWRITEBYTECODE=1

COPY --from=ghcr.io/astral-sh/uv:0.10.2 /uv /uvx /usr/local/bin/

WORKDIR /app

# Dependency layer first, so editing source doesn't invalidate the (large,
# slow-to-resolve) dependency install layer.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project

# `stage2_ingest.py`'s FHIR_VIEWS_DIR is resolved relative to its own
# checkout location (parent.parent.parent of the source file) -- so the
# image needs the full repo layout, not just an installed wheel. `uv sync`
# does an editable install pointing back at ./src either way.
COPY . .
RUN uv sync --frozen

# Bake the models in: same as `data-counts setup-models`, but at build time
# so the shipped image needs no run-time network access at all (beyond the
# pipeline's own single simulated outbound-to-program step). NLTK_DATA is
# pinned to a location nltk already checks by default regardless of $HOME --
# without it, nltk.download() lands under *this build step's* $HOME (root's,
# mid-build), which the non-root runtime user in the next stage can't see.
# The directory must exist *before* nltk.download() runs: nltk only picks a
# download destination from among the paths that already exist and are
# writable, so setting NLTK_DATA alone (without creating it) is a no-op.
# Note this path is OUTSIDE /app, so the runtime stage must copy it explicitly
# (see the second COPY --from=builder below) -- copying /app alone leaves the
# taggers behind and stage 7's Philter detector fails at run time.
ENV NLTK_DATA=/usr/local/share/nltk_data
RUN mkdir -p "$NLTK_DATA" && uv run data-counts setup-models

# Strip each dependency's own bundled test suite (~16MB: blis, spacy, srsly,
# fsspec, etc. all ship a tests/ package alongside their real code) -- dead
# weight for a runtime image, never imported by the packages' own non-test
# code paths. Verified safe by running the full test suite and a real
# `run-all` inside the built image afterward, not assumed.
RUN find /app/.venv/lib -type d \( -iname 'tests' -o -iname 'test' \) -prune -exec rm -rf {} +

# ---------------------------------------------------------------------------
FROM python:3.11-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 datacounts

WORKDIR /app
COPY --from=builder --chown=datacounts:datacounts /app /app

# The nltk taggers Philter needs live outside /app (see NLTK_DATA in the builder
# stage), so they need their own COPY -- root-owned and world-readable, since
# they are read-only reference data the runtime never writes to. NLTK_DATA must
# be re-declared: ENV does not carry across build stages.
COPY --from=builder /usr/local/share/nltk_data /usr/local/share/nltk_data

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    NLTK_DATA=/usr/local/share/nltk_data

# data/, outbox/ hold run state and output; drs/ can be overridden with a
# real partner-site DRS; keys/ is the mount point for the *program's* public key
# (stage 6's only external input -- see DATA_COUNTS_CENTRAL_PUBLIC_KEY in
# stage6_pprl.py, and the image-run target that mounts it read-only). No key
# material of any kind is baked into the image; none of this should be.
# Created and chowned as root, before dropping privileges -- the datacounts
# user doesn't have write access to create them itself under /app.
RUN mkdir -p data/lake/raw data/lake/views data/work data/review_queue outbox keys \
    && chown -R datacounts:datacounts data outbox keys
VOLUME ["/app/data", "/app/outbox", "/app/drs"]

USER datacounts

ENTRYPOINT ["data-counts"]
CMD ["run-all"]
